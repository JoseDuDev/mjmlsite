---
/**
 * Ícones em linha (stroke, 24x24). Inline em vez de sprite ou biblioteca:
 * são poucos, não valem um request nem uma dependência.
 */
interface Props {
  nome: keyof typeof paths
  size?: number
  class?: string
}

const paths = {
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/>',
  calendar:
    '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 2.5v4M16 2.5v4"/>',
  box: '<path d="M21 8.5v7a2 2 0 0 1-1 1.7l-6 3.5a2 2 0 0 1-2 0l-6-3.5a2 2 0 0 1-1-1.7v-7a2 2 0 0 1 1-1.7l6-3.5a2 2 0 0 1 2 0l6 3.5a2 2 0 0 1 1 1.7z"/><path d="m3.3 7.4 8.7 5 8.7-5M12 21.5v-9"/>',
  bag: '<path d="M6 2.5 3.5 6v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2V6L18 2.5z"/><path d="M3.5 6h17M16 10a4 4 0 0 1-8 0"/>',
  cart: '<circle cx="9.5" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 2.5h3l2.7 12.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.5L22 7H6.2"/>',
  globe: '<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5a15 15 0 0 1 0 19 15 15 0 0 1 0-19z"/>',
  code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
  spark:
    '<path d="M12 2.5 14.2 9l6.3 2.2-6.3 2.2L12 20l-2.2-6.6L3.5 11.2 9.8 9z"/><path d="M19 2.5v3M20.5 4h-3"/>',
  plug: '<path d="M9 2.5v6M15 2.5v6M6 8.5h12v3a6 6 0 0 1-6 6 6 6 0 0 1-6-6z"/><path d="M12 17.5v4"/>',
  whatsapp:
    '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6.5 8.1 5.6a1.6 1.6 0 0 0 1.8 0L21 6.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
} as const

const { nome, size = 24, class: className = '' } = Astro.props
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[nome]}
/>
