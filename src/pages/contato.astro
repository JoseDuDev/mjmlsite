---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { empresa, whatsappLink } from '../data/site'

// Site estático não tem backend. O formulário só aparece quando há um endpoint
// externo configurado (Web3Forms, Formspree e afins) em src/data/site.ts.
// Sem isso, WhatsApp e e-mail carregam o contato sozinhos — que é o canal que
// o público deste site usa de qualquer jeito.
const temFormulario = empresa.formEndpoint.length > 0
---

<Base
  titulo="Contato"
  descricao="Fale com a MJML por WhatsApp ou e-mail. Diagnóstico gratuito, sem compromisso, para empresas de todo o Brasil."
  caminho="/contato"
>
  <section class="topo">
    <div class="container topo__in">
      <p class="eyebrow">Contato</p>
      <h1 class="topo__h1">Vamos conversar sobre o seu negócio</h1>
      <p class="lead topo__lead">
        Trinta minutos para entender seu processo e apontar um caminho. Sem custo, sem compromisso e
        sem discurso de vendas.
      </p>
    </div>
  </section>

  <section class="section canais-sec">
    <div class="container canais">
      <a class="card canal canal--zap" href={whatsappLink()} target="_blank" rel="noopener">
        <span class="canal__icon">
          <Icon nome="whatsapp" size={22} />
        </span>
        <h2 class="canal__titulo">WhatsApp</h2>
        <p class="canal__desc">O caminho mais rápido. Costumamos responder no mesmo dia útil.</p>
        <span class="canal__acao">
          {empresa.telefoneExibicao}
          <Icon nome="arrow" size={15} />
        </span>
      </a>

      <a class="card canal" href={`mailto:${empresa.email}`}>
        <span class="canal__icon canal__icon--alt">
          <Icon nome="mail" size={22} />
        </span>
        <h2 class="canal__titulo">E-mail</h2>
        <p class="canal__desc">
          Para propostas, documentos e assuntos que pedem registro por escrito.
        </p>
        <span class="canal__acao">
          {empresa.email}
          <Icon nome="arrow" size={15} />
        </span>
      </a>
    </div>
  </section>

  {
    temFormulario && (
      <section class="section section--alt">
        <div class="container form-wrap">
          <div class="section-head form-head">
            <p class="eyebrow">Formulário</p>
            <h2 class="h2">Prefere escrever?</h2>
            <p class="lead">Conte o que você precisa e retornamos no próximo dia útil.</p>
          </div>

          <form class="form" action={empresa.formEndpoint} method="POST">
            <div class="campo">
              <label for="nome">Nome</label>
              <input id="nome" name="nome" type="text" required autocomplete="name" />
            </div>

            <div class="campo">
              <label for="email">E-mail</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>

            <div class="campo">
              <label for="empresa">Empresa</label>
              <input id="empresa" name="empresa" type="text" autocomplete="organization" />
            </div>

            <div class="campo">
              <label for="telefone">WhatsApp</label>
              <input id="telefone" name="telefone" type="tel" autocomplete="tel" />
            </div>

            <div class="campo campo--full">
              <label for="mensagem">O que você precisa?</label>
              <textarea id="mensagem" name="mensagem" rows="5" required></textarea>
            </div>

            <div class="campo--full form__rodape">
              <button class="btn btn--primary btn--lg" type="submit">
                Enviar mensagem
              </button>
              <p class="form__lgpd">
                Ao enviar, você concorda com a nossa{' '}
                <a href="/politica-de-privacidade">política de privacidade</a>. Usamos seus dados
                apenas para responder este contato.
              </p>
            </div>
          </form>
        </div>
      </section>
    )
  }

  <section class="section section--alt dados-sec">
    <div class="container">
      <div class="dados">
        <div>
          <h2 class="dados__titulo">Dados da empresa</h2>
          <dl class="dados__lista">
            <div>
              <dt>Razão social</dt>
              <dd>{empresa.razaoSocial}</dd>
            </div>
            <div>
              <dt>Nome fantasia</dt>
              <dd>{empresa.marca}</dd>
            </div>
            <div>
              <dt>CNPJ</dt>
              <dd>{empresa.cnpj}</dd>
            </div>
            <div>
              <dt>Atendimento</dt>
              <dd>Todo o Brasil, de forma remota</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .topo {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(1rem, 2vw, 1.5rem);
  }

  .topo__in {
    max-width: 44rem;
  }

  .topo__h1 {
    margin-top: 0.75rem;
    font-size: var(--t-display);
  }

  .topo__lead {
    margin-top: 1.25rem;
  }

  .canais-sec {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .canais {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .canal {
    display: block;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .canal:hover {
    border-color: #cbd5e1;
    box-shadow: var(--shadow);
    text-decoration: none;
  }

  .canal__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-sm);
    background: var(--grad);
    color: #fff;
    margin-bottom: 1.25rem;
  }

  .canal__icon--alt {
    background: #eff6ff;
    color: var(--blue);
  }

  .canal__titulo {
    font-size: var(--t-h3);
  }

  .canal__desc {
    margin-top: 0.5rem;
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .canal__acao {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--blue);
  }

  /* ── Formulário ── */
  .form-wrap {
    max-width: 46rem;
  }

  .form-head {
    margin-bottom: 2rem;
  }

  .form {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .campo {
    display: grid;
    gap: 0.4375rem;
  }

  .campo--full {
    grid-column: 1 / -1;
  }

  .campo label {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .campo input,
  .campo textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: #fff;
    font-size: var(--t-sm);
    resize: vertical;
  }

  .campo input:focus-visible,
  .campo textarea:focus-visible {
    border-color: var(--blue);
  }

  .form__rodape {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .form__lgpd {
    font-size: var(--t-xs);
    color: var(--muted);
    max-width: 46ch;
  }

  /* ── Dados ── */
  .dados__titulo {
    font-size: var(--t-h3);
  }

  .dados__lista {
    display: grid;
    gap: 1.25rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin-top: 1.5rem;
  }

  .dados__lista dt {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .dados__lista dd {
    margin: 0.375rem 0 0;
    font-size: var(--t-sm);
    color: var(--ink);
    font-weight: 500;
  }
</style>
